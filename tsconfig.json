{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"paths": {
			"@root/*": ["./src/*"],
			"@api/*": ["./src/api/*"],
			"@controllers/*": ["./src/api/controllers/*"],
			"@middlewares/*": ["./src/api/middlewares/*"],
			"@validation/*": ["./src/api/validation/*"],
			"@config/*": ["./src/config/*"],
			"@core/*": ["./src/core/*"],
			"@errors/*": ["./src/core/errors/*"],
			"@interfaces/*": ["./src/core/interfaces/*"],
			"@domain-types/*": ["./src/core/types/*"],
			"@typing/*": ["./src/core/types/*"],
			"@core/types/*": ["./src/core/types/*"],
			"@infrastructure/*": ["./src/infrastructure/*"],
			"@analytics/*": ["./src/infrastructure/analytics/*"],
			"@sinks/*": ["./src/infrastructure/analytics/sinks/*"],
			"@cache/*": ["./src/infrastructure/cache/*"],
			"@experiments/*": ["./src/infrastructure/experiments/*"],
			"@observability/*": ["./src/infrastructure/observability/*"],
			"@providers/*": ["./src/infrastructure/providers/*"],
			"@services/*": ["./src/services/*"]
		},
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictBindCallApply": true,
		"strictPropertyInitialization": true,
		"noImplicitThis": true,
		"alwaysStrict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"resolveJsonModule": true
	},
	"include": ["./src/**/*"],
	"exclude": ["node_modules", "dist"]
}
