# ==============================================================================
# OpenSearch Product API - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and adjust values for your local or production setup:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'test', or 'production'
NODE_ENV=development

# Server port to bind to
PORT=3000

# Server host address (use 0.0.0.0 for Docker containers)
HOST=0.0.0.0

# Log level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=debug

# Default search provider when not specified in query or A/B test
# Options: 'mock', 'example'
DEFAULT_PROVIDER=mock

# ------------------------------------------------------------------------------
# 2. REDIS SESSION & PERSONALIZATION CACHE
# ------------------------------------------------------------------------------
# Redis connection URL for real-time session affinities and response caching
REDIS_URL=redis://localhost:6379

# Key prefix for session affinity hashes
REDIS_SESSION_PREFIX=session:

# Session Time-To-Live (TTL) in seconds (default: 1800s = 30 minutes)
REDIS_SESSION_TTL_SECONDS=1800

# ------------------------------------------------------------------------------
# 3. ANALYTICS SINKS CONFIGURATIONS (POSTGRESQL & EXAMPLE SINK)
# ------------------------------------------------------------------------------
# Maximum number of events to buffer in memory before triggering a batch flush
ANALYTICS_BATCH_SIZE=50

# Maximum interval (in milliseconds) before flushing buffered analytics events
ANALYTICS_FLUSH_INTERVAL_MS=1000

# PostgreSQL Transactional Analytics Sink (Optional connection string)
POSTGRES_URL=postgresql://postgres:postgres_password@localhost:5432/search_analytics

# ------------------------------------------------------------------------------
# 4. RESILIENCE & CIRCUIT BREAKER POLICIES
# ------------------------------------------------------------------------------
# Provider request timeout in milliseconds before triggering abort and fallback
PROVIDER_TIMEOUT_MS=2500

# Percentage of failed requests within rolling window to open the circuit (0 - 100)
CIRCUIT_BREAKER_ERROR_THRESHOLD=50

# Duration in milliseconds to keep circuit open before attempting half-open probe
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
