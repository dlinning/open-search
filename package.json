{
  "name": "open-search-api",
  "version": "1.0.0",
  "description": "Enterprise-grade Product Search API with Multi-Provider Orchestration, A/B Testing, and Real-Time Analytics",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "yarn typecheck && yarn lint && tsc && tsc-alias",
    "start": "yarn build && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/sensible": "^6.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "murmurhash": "^2.0.1",
    "opossum": "^8.4.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/opossum": "^8.1.7",
    "oxlint": "^0.15.11",
    "prettier": "^3.5.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
